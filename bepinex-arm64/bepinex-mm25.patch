diff --git a/BepInEx/PlatformCompat.cs b/BepInEx/PlatformCompat.cs
new file mode 100644
index 0000000..777957b
--- /dev/null
+++ b/BepInEx/PlatformCompat.cs
@@ -0,0 +1,63 @@
+using System;
+using MonoMod.Utils;
+
+namespace BepInEx
+{
+	/// <summary>
+	/// The platform flags BepInEx checks against.
+	/// </summary>
+	[Flags]
+	internal enum Platform
+	{
+		Unknown = 0,
+		Windows = 1 << 0,
+		MacOS = 1 << 1,
+		Linux = 1 << 2,
+		Unix = 1 << 3,
+		Bits64 = 1 << 4,
+		ARM = 1 << 5,
+	}
+
+	/// <summary>
+	/// Answers platform questions from MonoMod's detection.
+	/// </summary>
+	internal static class PlatformHelper
+	{
+		public static Platform Current
+		{
+			get
+			{
+				var os = PlatformDetection.OS;
+				var current = Platform.Unknown;
+
+				if (os.Is(OSKind.Windows)) current |= Platform.Windows;
+				if (os.Is(OSKind.OSX)) current |= Platform.MacOS | Platform.Unix;
+				if (os.Is(OSKind.Linux)) current |= Platform.Linux | Platform.Unix;
+				if (os.Is(OSKind.Posix)) current |= Platform.Unix;
+
+				if (IntPtr.Size >= 8) current |= Platform.Bits64;
+
+				var arch = PlatformDetection.Architecture;
+				if (arch == ArchitectureKind.Arm || arch == ArchitectureKind.Arm64) current |= Platform.ARM;
+
+				return current;
+			}
+		}
+
+		public static bool Is(Platform platform) => (Current & platform) == platform;
+	}
+}
+
+namespace BepInEx.Unix
+{
+	using System.Runtime.InteropServices;
+
+	/// <summary>
+	/// Turns a native function pointer into a delegate.
+	/// </summary>
+	internal static class NativePointerExtensions
+	{
+		public static T AsDelegate<T>(this System.IntPtr ptr) where T : class
+			=> Marshal.GetDelegateForFunctionPointer(ptr, typeof(T)) as T;
+	}
+}
